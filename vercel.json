{
  "buildCommand": "cd aiconference && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "aiconference/dist",
  "installCommand": "cd aiconference && npm install --legacy-peer-deps",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "ENABLE_GIT_LFS": "1"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
